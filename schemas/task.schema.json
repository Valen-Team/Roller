{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roller.dev/schemas/task.schema.json",
  "title": "Roller Task Bundle v1",
  "type": "object",
  "required": ["schema_version", "id"],
  "properties": {
    "schema_version": {"const": "roller.task/v1"},
    "id": {"type": ["string", "integer"]},
    "file_root": {
      "type": "string",
      "minLength": 1,
      "description": "Task workspace root for relative input/context sources and output_dir; itself relative to the task-list directory"
    },
    "harness": {
      "$ref": "#/$defs/harness",
      "default": "openclaw",
      "description": "Harness used by the Task Agent; --harness can override it for a collection run"
    },
    "agent_harness": {
      "$ref": "#/$defs/harness",
      "description": "Explicit alias for the Task Agent harness"
    },
    "task_agent": {
      "type": "object",
      "properties": {
        "harness": {"$ref": "#/$defs/harness"},
        "model": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true,
      "description": "Optional explicit Task Agent harness/model declaration"
    },
    "agent": {
      "type": "object",
      "properties": {
        "harness": {"$ref": "#/$defs/harness"},
        "model": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true,
      "description": "Compatibility alias for task_agent"
    },
    "prompt": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {"const": "user"},
              "content": {"type": "string", "minLength": 1},
              "new_session": {
                "type": "boolean",
                "default": false,
                "description": "Start a fresh Harness session before this message; not allowed on the first message"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "user_simulator": {
      "type": "object",
      "required": ["instruction"],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "description": "Fixed persona and goal prompt given to the User Simulator on every turn"
        },
        "harness": {"$ref": "#/$defs/harness", "default": "openclaw"},
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Simulator model; defaults to the task-agent model"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 6,
          "description": "Maximum number of instructions delivered to the task agent"
        },
        "thinking": {
          "enum": ["off", "none", "minimal", "low", "medium", "high", "xhigh", "adaptive", "max", "ultra"]
        }
      },
      "additionalProperties": false
    },
    "model": {"type": "string", "minLength": 1},
    "files": {
      "type": "object",
      "properties": {
        "output_dir": {
          "anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}],
          "default": "outputs",
          "description": "Writable subdirectory of the file_root workspace; every file under it is collected. null (Stirrup) creates none and collects nothing"
        },
        "inputs": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/relativePath"},
              {
                "type": "object",
                "properties": {
                  "source": {"$ref": "#/$defs/relativePath"},
                  "content": {
                    "type": "string",
                    "description": "Inline file content; mutually exclusive with source"
                  },
                  "target": {
                    "$ref": "#/$defs/relativePath",
                    "description": "Path inside the workspace; defaults to source"
                  },
                  "path": {
                    "$ref": "#/$defs/relativePath",
                    "description": "Alias for target"
                  },
                  "required": {"type": "boolean", "default": true},
                  "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
                },
                "oneOf": [
                  {"required": ["source"], "not": {"required": ["content"]}},
                  {
                    "required": ["content"],
                    "not": {"required": ["source"]},
                    "anyOf": [{"required": ["target"]}, {"required": ["path"]}]
                  }
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "input_mode": {
          "enum": ["mount", "copy"],
          "default": "mount",
          "description": "Mount the inputs read-only or copy them into the workspace"
        },
        "attach_images": {
          "type": "array",
          "items": {"$ref": "#/$defs/relativePath"},
          "uniqueItems": true,
          "description": "Input image paths (png, jpg, jpeg, webp, gif) sent to the model with the first user message"
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "source"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "target": {"$ref": "#/$defs/relativePath"},
              "capture": {"enum": ["full", "hash", "none"]},
              "required": {"type": "boolean", "default": true}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "env": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "setup": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "thinking": {
          "enum": ["off", "none", "minimal", "low", "medium", "high", "xhigh", "adaptive", "max", "ultra"]
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Docker image for this task; overrides the Harness image"
        },
        "image_build": {
          "type": "object",
          "required": ["base_image", "context", "dockerfile", "harness"],
          "properties": {
            "base_image": {"type": "string", "minLength": 1},
            "context": {
              "type": "string",
              "minLength": 1,
              "description": "Build context directory, absolute or relative to file_root"
            },
            "dockerfile": {
              "type": "string",
              "minLength": 1,
              "description": "Dockerfile source text"
            },
            "harness": {"$ref": "#/$defs/harness"},
            "args": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number", "boolean"]}
            },
            "timeout_seconds": {"type": "integer", "minimum": 1, "default": 3600}
          },
          "description": "Build runtime.image before the run; requires runtime.image"
        },
        "workspace_path": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute workspace path inside the container"
        }
      },
      "dependentRequired": {"image_build": ["image"]},
      "additionalProperties": false
    }
  },
  "anyOf": [
    {"required": ["prompt"]},
    {"required": ["question"]},
    {"required": ["messages"]},
    {"required": ["user_simulator"]}
  ],
  "allOf": [
    {
      "if": {"required": ["user_simulator"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["prompt"]},
            {"required": ["question"]},
            {"required": ["messages"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "harness": {
      "enum": ["openclaw", "codex", "claude-code", "hermes", "opencode", "deepseek", "pi", "stirrup"]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"
    }
  },
  "additionalProperties": true
}

