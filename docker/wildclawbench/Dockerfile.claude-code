ARG WILDCLAW_BASE=ghcr.io/valen-team/roller-wildclaw-base:1.3-clean.1
ARG NODE_IMAGE=node:22.22.0-bookworm-slim
FROM ${NODE_IMAGE} AS node
FROM ${WILDCLAW_BASE}

COPY --from=node /usr/local/bin/node /opt/roller-claude-node/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /opt/roller-claude-node/npm
COPY --from=node /usr/local/LICENSE /usr/share/doc/roller-wildclaw/LICENSE-Node
COPY claude-launcher.sh /usr/local/bin/claude

ARG CLAUDE_CODE_VERSION=2.1.222
ARG INSTALL_CLAUDE_CODE=0
ENV ROLLER_CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION} \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    IS_SANDBOX=1
RUN chmod 755 /usr/local/bin/claude \
    && if [ "$INSTALL_CLAUDE_CODE" = 1 ]; then claude --version; fi

LABEL org.opencontainers.image.source="https://github.com/Valen-Team/Roller" \
      org.opencontainers.image.version="1.3-claude${CLAUDE_CODE_VERSION}" \
      org.opencontainers.image.description="WildClawBench task environment for Claude Code"
WORKDIR /tmp_workspace
CMD ["bash"]
