ARG WILDCLAW_BASE=ghcr.io/valen-team/roller-wildclaw-base:1.3-clean.1@sha256:af95ec880dfecc1f0af933c9c80ebf103c4c6a2c82170ee34250dc8f387a7e2a
ARG OPENCODE_RUNTIME=ghcr.io/valen-team/roller-opencode:1.18.30@sha256:0363906393abea87c868f13d95ec66fcce45bc14b67b70e3de6166d462653930
FROM ${OPENCODE_RUNTIME} AS opencode
FROM ${WILDCLAW_BASE}

COPY --link --from=opencode /usr/local/bin/opencode /usr/local/bin/uv /usr/local/bin/uvx /usr/bin/rg /usr/local/bin/
COPY --link --from=opencode /opt/roller-opencode-deps /opt/roller-opencode-deps
COPY --link --from=opencode /usr/local/lib/python3.12/site-packages/uv-0.9.7.dist-info/licenses /usr/share/doc/roller-wildclaw/uv/
COPY --link --from=opencode /usr/share/doc/ripgrep/copyright /usr/share/doc/roller-wildclaw/LICENSE-ripgrep
COPY --link LICENSE-OpenCode THIRD_PARTY_NOTICES /usr/share/doc/roller-wildclaw/

LABEL org.opencontainers.image.source="https://github.com/Valen-Team/Roller" \
      org.opencontainers.image.version="1.3-opencode1.18.30" \
      org.opencontainers.image.description="WildClawBench task environment with OpenCode 1.18.30"
ENV OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_MODELS_FETCH=1
CMD ["bash"]
